# BedrockOps — copy to .env and adjust for your environment
# Never commit .env with real secrets.

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Web (apps/web) — proxies /api/v1 to API server ---
API_URL=http://localhost:4000
# Opt-in only: enables silent admin login in the dashboard (local dev).
NEXT_PUBLIC_DEV_AUTO_LOGIN=true

DATABASE_URL=postgresql://mcadmin:mcadmin_password@localhost:5432/minecraft_admin
# memory = in-process only (tests/local). prisma = hydrate/flush against Postgres (staging/prod).
DB_ADAPTER=memory
# ALLOW_MEMORY_DB=true
# Production must set ALLOW_MEMORY_DB=true to boot with MemoryDatabase (not recommended),
# or wire the Prisma adapter.
# ALLOW_MEMORY_DB=false

# --- API (apps/api) ---
# API listens on 4000 by default when started directly
JWT_SECRET=dev_jwt_secret_change_in_production
NODE_PAIRING_SECRET=dev_node_pairing_secret_change_in_production
# Restrict in production — never use *
CORS_ORIGIN=http://localhost:3000

# --- Agent (apps/agent) ---
AGENT_PORT=5050
BEDROCK_CONTROL_PLANE=http://127.0.0.1:4000
BEDROCK_NODE_ID=node_docker_agent_1
# Must match the SHA-256 hash stored on the AgentNode (seeded hash of this value in MemoryDatabase).
BEDROCK_AGENT_TOKEN=dev_agent_token_change_me
# Comma-separated upload host allowlist (suffix match with leading dot supported)
# R2_ALLOWED_UPLOAD_HOSTS=.r2.cloudflarestorage.com,127.0.0.1,localhost

# --- Bedrock / RCON ---
BEDROCK_SERVER_PATH=/var/minecraft/bedrock-server-1
RCON_HOST=127.0.0.1
RCON_PORT=19133
RCON_PASSWORD=secret_rcon_pass

# --- Discord (optional) ---
DISCORD_WEBHOOK_URL=
# Slash commands (guild sync) — all three required for live registration:
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_GUILD_ID=
# Optional channel→server map JSON: {"1234567890":"srv_bedrock_1"}
# DISCORD_CHANNEL_MAP_JSON=

# --- Cloudflare DNS (optional live play.* records) ---
# PLAY_BASE_DOMAIN=play.bedrockops.io
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# --- Xbox / OpenXBL (optional live gamertag↔XUID) ---
# XBOX_API_KEY=
# OPENXBL_API_KEY=
# XBOX_FRIEND_BOT_GAMERTAG=BedrockOps Onboarding Bot

# --- Cloudflare R2 (optional streaming backups) ---
# When unset, backups stay local/agent-side and presign returns an honest stub.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_JURISDICTION=eu

# --- API listen port (apps/api). Root PORT=3000 is for the web app — override here. ---
# PORT=4000
