# syntax=docker/dockerfile:1
# BedrockOps web dashboard (Next.js)
FROM node:20-bookworm-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG API_URL=http://localhost:4000
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV API_URL=$API_URL \
  NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
  NEXT_TELEMETRY_DISABLED=1 \
  DATABASE_URL=postgresql://mcadmin:mcadmin_password@postgres:5432/minecraft_admin
# Web needs auth/ui packages; generate is cheap insurance for workspace graph.
RUN pnpm --filter @mc-admin/db db:generate \
  && pnpm --filter @mc-admin/web... build

FROM base AS runner
ARG API_URL=http://localhost:4000
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NODE_ENV=production \
  PORT=3000 \
  API_URL=$API_URL \
  NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
  NEXT_TELEMETRY_DISABLED=1 \
  NEXT_PUBLIC_DEV_AUTO_LOGIN=false
COPY --from=build /app /app
WORKDIR /app
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD curl -sf http://127.0.0.1:3000/login || exit 1
CMD ["pnpm", "--filter", "@mc-admin/web", "exec", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
