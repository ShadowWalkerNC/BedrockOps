{
  "name": "@mc-admin/agent",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && pnpm run agent:build",
    "dev": "ts-node src/index.ts",
    "test": "vitest run && go test ./...",
    "agent:build": "mkdir -p bin && go build -o bin/bedrock-agent ./cmd/bedrock-agent",
    "agent:test": "go test ./...",
    "agent:run": "go run ./cmd/bedrock-agent"
  },
  "dependencies": {
    "@mc-admin/config": "workspace:*",
    "@mc-admin/bedrock": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2",
    "vitest": "^1.6.0"
  }
}
